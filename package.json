  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "husky": "^8.0.0"
  }
